{
  "name": "bamboo-ink",
  "type": "module",
  "version": "1.0.0",
  "description": "🎋 古籍现代化改造项目 - 传承中华文化，让古籍阅读更现代化",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "convert": "bun run scripts/convert-htm-to-md.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "validate": "bun run lint && bun run format && bun run check"
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "5.2.9",
    "@fontsource/noto-serif-sc": "5.2.8",
    "@tailwindcss/postcss": "^4.0.0",
    "astro": "^6.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@types/node": "25.5.2",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "cheerio": "^1.0.0",
    "eslint": "10.2.0",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.4.0",
    "iconv-lite": "^0.6.3",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "turndown": "^7.2.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1"
  }
}
