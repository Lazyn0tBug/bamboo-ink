---
import '../styles/global.css';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  template?: 'classic' | 'simple' | 'deluxe';
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-template="classic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="古籍现代化阅读平台" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Astro 6 Fonts API - 自托管字体 -->
    <Font cssVariable="--font-noto" preload />
    <Font cssVariable="--font-ma-shan-zheng" preload />
    <title>{title} - 古籍图书馆</title>
    <style>
      /* HTML data-template 属性控制模板切换 */
      html[data-template='classic'] body {
        background-color: #f7f5f0;
      }
      html[data-template='classic'] .layout-border {
        border-color: #e0d8c8;
      }
      html[data-template='classic'] .layout-pattern {
        display: block;
      }
      html[data-template='classic'] .template-nav {
        background-color: rgba(254, 253, 251, 0.9);
      }

      html[data-template='simple'] body {
        background-color: #ffffff;
      }
      html[data-template='simple'] .layout-border {
        border-color: #cccccc;
      }
      html[data-template='simple'] .layout-pattern {
        display: none;
      }
      html[data-template='simple'] .template-nav {
        background-color: rgba(255, 255, 255, 0.9);
      }

      html[data-template='deluxe'] body {
        background: linear-gradient(to bottom, #fefdfb, #efebd1);
      }
      html[data-template='deluxe'] .layout-border {
        border-color: #f59898;
      }
      html[data-template='deluxe'] .layout-pattern {
        display: block;
      }
      html[data-template='deluxe'] .template-nav {
        background: linear-gradient(135deg, rgba(254, 245, 245, 0.95), rgba(253, 232, 232, 0.9));
      }
    </style>
  </head>
  <body class="min-h-screen font-kai text-text">
    <!-- 宣纸纹理背景（仅 classic 和 deluxe 模板） -->
    <div class="xuanzhi-texture fixed inset-0 pointer-events-none z-0 layout-pattern"></div>

    <!-- 顶部导航 -->
    <nav
      class="template-nav border-b layout-border backdrop-blur-sm sticky top-0 z-50 transition-all duration-300"
    >
      <div class="max-w-6xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center space-x-3">
            <div
              class="w-10 h-10 bg-zhusha-500 rounded-lg flex items-center justify-center font-li"
            >
              <span class="text-white text-2xl">古</span>
            </div>
            <div>
              <h1 class="text-lg font-bold text-text font-li">古籍图书馆</h1>
              <p class="text-xs text-text-secondary font-song">Classic Library</p>
            </div>
          </a>

          <!-- 搜索框 -->
          <div class="flex-1 max-w-md mx-8">
            <div class="relative">
              <input
                type="text"
                placeholder="搜索古籍..."
                class="w-full px-4 py-2 border border-border rounded-lg bg-surface/80 focus:outline-none focus:ring-2 focus:ring-accent/50 transition-colors"
              />
              <svg
                class="w-5 h-5 absolute right-3 top-2.5 text-text-tertiary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>

          <!-- 模板切换 -->
          <div class="flex items-center space-x-2 border-r border-border pr-4 mr-4">
            <button
              data-template="classic"
              class="px-3 py-1.5 rounded text-sm text-text-secondary hover:bg-surface/50">古典</button
            >
            <button
              data-template="simple"
              class="px-3 py-1.5 rounded text-sm text-text-secondary hover:bg-surface/50">简约</button
            >
            <button
              data-template="deluxe"
              class="px-3 py-1.5 rounded text-sm text-text-secondary hover:bg-surface/50">华丽</button
            >
          </div>

          <!-- 明暗主题切换按钮 -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-lg hover:bg-surface/50 transition-colors"
            aria-label="切换明暗主题"
            title="切换明暗主题">
            <!-- 太阳图标 (亮色主题时显示) -->
            <svg id="sun-icon" class="w-5 h-5 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <!-- 月亮图标 (暗色主题时显示) -->
            <svg id="moon-icon" class="w-5 h-5 text-text-secondary" style="display:none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <!-- 主体内容 -->
    <main class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- 页脚 -->
    <footer class="border-t layout-border mt-16 py-8 template-nav">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <p class="mo-text text-sm">古籍现代化改造项目 © 2026</p>
        <p class="mt-2 text-sm text-mo-400">Powered by Astro & Tailwind CSS</p>
      </div>
    </footer>

    <!-- 古典纹样装饰（仅 classic 和 deluxe 模板） -->
    <div class="layout-pattern fixed top-0 left-0 w-full h-full pointer-events-none z-0">
      <svg class="w-full h-full opacity-[0.03]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="wenxiang" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="40" fill="none" stroke="#2c2c2c" stroke-width="1"></circle>
            <rect
              x="20"
              y="20"
              width="60"
              height="60"
              fill="none"
              stroke="#2c2c2c"
              stroke-width="1"
              transform="rotate(45 50 50)"></rect>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#wenxiang)"></rect>
      </svg>
    </div>

    <!-- 模板切换脚本 -->
    <script is:inline>
      (function() {
        function init() {
          const html = document.documentElement;
          const themeToggle = document.getElementById('theme-toggle');
          const sunIcon = document.getElementById('sun-icon');
          const moonIcon = document.getElementById('moon-icon');

          if (!themeToggle || !sunIcon || !moonIcon) {
            console.error('[Theme] Elements missing');
            return;
          }

          console.log('[Theme] Initialized');

          // 设置主题
          function applyTheme(theme) {
            html.setAttribute('data-theme', theme);
            localStorage.setItem('preferredTheme', theme);
            
            // 更新图标：dark 显示月亮，light 显示太阳
            if (theme === 'dark') {
              sunIcon.style.display = 'none';
              moonIcon.style.display = '';
            } else {
              sunIcon.style.display = '';
              moonIcon.style.display = 'none';
            }
            
            console.log('[Theme] Applied:', theme);
          }

          // 点击切换
          themeToggle.addEventListener('click', function(e) {
            e.preventDefault();
            const current = html.getAttribute('data-theme') || 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            applyTheme(next);
          });

          // 初始化
          const saved = localStorage.getItem('preferredTheme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const initial = saved || (prefersDark ? 'dark' : 'light');
          
          // 确保初始主题正确应用
          applyTheme(initial);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
