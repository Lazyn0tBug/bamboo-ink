---
import '../styles/global.css';

interface Props {
  title: string;
  template?: 'classic' | 'simple' | 'deluxe';
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-template="classic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="古籍现代化阅读平台" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600;700&family=Ma+Shan+Zheng&family=ZCOOL+KuaiLe&display=swap"
      rel="stylesheet"
    />
    <title>{title} - 古籍图书馆</title>
    <style>
      /* HTML data-template 属性控制模板切换 */
      html[data-template='classic'] body {
        background-color: #f7f5f0;
      }
      html[data-template='classic'] .layout-border {
        border-color: #e0d8c8;
      }
      html[data-template='classic'] .layout-pattern {
        display: block;
      }
      html[data-template='classic'] .template-nav {
        background-color: rgba(254, 253, 251, 0.9);
      }

      html[data-template='simple'] body {
        background-color: #ffffff;
      }
      html[data-template='simple'] .layout-border {
        border-color: #cccccc;
      }
      html[data-template='simple'] .layout-pattern {
        display: none;
      }
      html[data-template='simple'] .template-nav {
        background-color: rgba(255, 255, 255, 0.9);
      }

      html[data-template='deluxe'] body {
        background: linear-gradient(to bottom, #fefdfb, #efebd1);
      }
      html[data-template='deluxe'] .layout-border {
        border-color: #f59898;
      }
      html[data-template='deluxe'] .layout-pattern {
        display: block;
      }
      html[data-template='deluxe'] .template-nav {
        background: linear-gradient(135deg, rgba(254, 245, 245, 0.95), rgba(253, 232, 232, 0.9));
      }
    </style>
  </head>
  <body class="min-h-screen font-kai text-mo-500">
    <!-- 宣纸纹理背景（仅 classic 和 deluxe 模板） -->
    <div class="xuanzhi-texture fixed inset-0 pointer-events-none z-0 layout-pattern"></div>

    <!-- 顶部导航 -->
    <nav
      class="template-nav border-b layout-border backdrop-blur-sm sticky top-0 z-50 transition-all duration-300"
    >
      <div class="max-w-6xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center space-x-3">
            <div
              class="w-10 h-10 bg-zhusha-500 rounded-lg flex items-center justify-center font-li"
            >
              <span class="text-white text-2xl">古</span>
            </div>
            <div>
              <h1 class="text-lg font-bold text-mo-600 font-li">古籍图书馆</h1>
              <p class="text-xs text-mo-400 font-song">Classic Library</p>
            </div>
          </a>

          <!-- 搜索框 -->
          <div class="flex-1 max-w-md mx-8">
            <div class="relative">
              <input
                type="text"
                placeholder="搜索古籍..."
                class="w-full px-4 py-2 border border-juanbo-300 rounded-lg bg-white/80 focus:outline-none focus:ring-2 focus:ring-zhusha-500/50"
              />
              <svg
                class="w-5 h-5 absolute right-3 top-2.5 text-mo-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>

          <!-- 模板切换 -->
          <div class="flex items-center space-x-2">
            <button
              data-template="classic"
              class="px-3 py-1.5 rounded text-sm text-mo-500 hover:bg-xuanzhi-200">古典</button
            >
            <button
              data-template="simple"
              class="px-3 py-1.5 rounded text-sm text-mo-500 hover:bg-xuanzhi-200">简约</button
            >
            <button
              data-template="deluxe"
              class="px-3 py-1.5 rounded text-sm text-mo-500 hover:bg-xuanzhi-200">华丽</button
            >
          </div>
        </div>
      </div>
    </nav>

    <!-- 主体内容 -->
    <main class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- 页脚 -->
    <footer class="border-t layout-border mt-16 py-8 template-nav">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <p class="mo-text text-sm">古籍现代化改造项目 © 2026</p>
        <p class="mt-2 text-sm text-mo-400">Powered by Astro & Tailwind CSS</p>
      </div>
    </footer>

    <!-- 古典纹样装饰（仅 classic 和 deluxe 模板） -->
    <div class="layout-pattern fixed top-0 left-0 w-full h-full pointer-events-none z-0">
      <svg class="w-full h-full opacity-[0.03]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="wenxiang" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <circle cx="50" cy="50" r="40" fill="none" stroke="#2c2c2c" stroke-width="1"></circle>
            <rect
              x="20"
              y="20"
              width="60"
              height="60"
              fill="none"
              stroke="#2c2c2c"
              stroke-width="1"
              transform="rotate(45 50 50)"></rect>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#wenxiang)"></rect>
      </svg>
    </div>

    <!-- 模板切换脚本 -->
    <script is:inline>
      // 模板切换功能 - 使用 localStorage 保存偏好
      const html = document.documentElement;
      const templateButtons = document.querySelectorAll('[data-template]');

      // 设置模板
      function setTemplate(template) {
        html.setAttribute('data-template', template);
        localStorage.setItem('preferredTemplate', template);

        // 更新按钮状态
        templateButtons.forEach((btn) => {
          const buttonTemplate = btn.getAttribute('data-template');
          if (buttonTemplate === template) {
            btn.classList.add('bg-zhusha-500', 'text-white');
            btn.classList.remove('text-mo-500', 'hover:bg-xuanzhi-200');
          } else {
            btn.classList.remove('bg-zhusha-500', 'text-white');
            btn.classList.add('text-mo-500', 'hover:bg-xuanzhi-200');
          }
        });
      }

      // 绑定点击事件
      templateButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const template = btn.getAttribute('data-template');
          setTemplate(template);
        });
      });

      // 初始化：从 URL 或 localStorage 读取偏好
      const urlTemplate = new URLSearchParams(window.location.search).get('template');
      const savedTemplate = localStorage.getItem('preferredTemplate') || 'classic';

      if (urlTemplate) {
        setTemplate(urlTemplate);
      } else {
        setTemplate(savedTemplate);
      }
    </script>
  </body>
</html>
