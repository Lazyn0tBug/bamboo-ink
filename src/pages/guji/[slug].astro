---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { z } from 'astro/zod';

interface Props {
  slug: string;
  data: GujiData;
}

// 数据验证 Schema
const GujiAnnotationSchema = z.object({
  term: z.string(),
  note: z.string(),
  type: z.enum(['philosophy', 'person', 'concept', 'place', 'event']),
});

const GujiDataSchema = z.object({
  title: z.string(),
  section: z.string(),
  author: z.string(),
  description: z.string(),
  content: z.string(),
  annotations: z.array(GujiAnnotationSchema).default([]),
});

type GujiData = z.infer<typeof GujiDataSchema>;

const { slug } = Astro.props;

export async function getStaticPaths() {
  const gujiData = {
    'zhong-yong': { title: '中庸', section: '经部' },
  };

  return Object.entries(gujiData).map(([slug, data]) => ({
    params: { slug },
    props: { data },
  }));
}

// 示例数据 - 实际会从 Markdown 文件读取
const gujiDataRaw = {
  'zhong-yong': {
    title: '中庸',
    section: '经部',
    author: '孔子之孙子思',
    description: '儒家经典之一，论述中庸之道',
    content: `
      <div class="guji-text">
        <h2 class="text-2xl font-bold text-mo-600 mb-6">中庸章句</h2>
        
        <div class="chapter mb-8">
          <h3 class="text-xl font-bold text-zhusha-500 mb-4">第一章</h3>
          <p class="mb-4 leading-loose">
            <span class="text-mo-600">天命之谓性，率性之谓道，修道之谓教。</span>
          </p>
        </div>
      </div>
    `,
    annotations: [
      { term: '天命', note: '上天赋予的本性', type: 'philosophy' },
      { term: '性', note: '人的本性、天性', type: 'philosophy' },
    ],
  },
};

// 数据验证与错误处理
let data: GujiData | null = null;

try {
  const rawData = gujiDataRaw[slug as keyof typeof gujiDataRaw];

  if (!rawData) {
    // 数据不存在，返回 404
    return Astro.redirect('/404');
  }

  // 验证数据结构
  const validated = GujiDataSchema.safeParse(rawData);

  if (!validated.success) {
    // 数据验证失败
    console.error('[Guji Page] Validation error:', validated.error.message);
    return Astro.redirect('/404');
  }

  data = validated.data;
} catch (e) {
  // 未知错误处理
  const error = e instanceof Error ? e : new Error('未知错误');
  console.error('[Guji Page] Unexpected error:', error);
  return Astro.redirect('/404');
}

// 最终检查：确保数据存在
if (!data) {
  console.error('[Guji Page] Data not found after validation:', slug);
  return Astro.redirect('/404');
}

const template = new URL(Astro.request.url).searchParams.get('template') || 'classic';
---

<BaseLayout title={data.title} template={template as 'classic' | 'simple'}>
  <!-- 面包屑导航 -->
  <nav class="mb-6" aria-label="面包屑导航">
    <ol
      class="flex items-center space-x-2 text-sm text-text-secondary"
      itemscope
      itemtype="https://schema.org/BreadcrumbList"
    >
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" class="hover:text-accent" itemprop="item">
          <span itemprop="name">首页</span>
        </a>
        <meta itemprop="position" content="1" />
      </li>
      <li>/</li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href={`/${data.section}`} class="hover:text-accent" itemprop="item">
          <span itemprop="name">{data.section}</span>
        </a>
        <meta itemprop="position" content="2" />
      </li>
      <li>/</li>
      <li class="text-text" aria-current="page">{data.title}</li>
    </ol>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 主内容区 -->
    <div class="lg:col-span-3">
      <article class="bg-surface rounded-xl shadow-lg p-8 border border-border">
        <!-- 标题区域 -->
        <header class="mb-8 pb-6 border-b border-border">
          <h1 class="text-4xl font-bold text-text mb-2">{data.title}</h1>
          <p class="text-text-secondary mb-2">{data.description}</p>
          <div class="flex items-center space-x-4 text-sm text-text-secondary">
            <span>作者：{data.author}</span>
            <span>•</span>
            <span>{data.section}</span>
          </div>
        </header>

        <!-- 正文区域 -->
        <div class="guji-text text-lg leading-loose">
          <div set:html={data.content} />
        </div>

        <!-- 阅读工具栏 -->
        <div class="mt-8 pt-6 border-t border-border flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <button
              class="px-4 py-2 bg-surface hover:bg-surface/80 text-text rounded-lg transition-colors"
            >
              ← 上一章
            </button>
            <button
              class="px-4 py-2 bg-surface hover:bg-surface/80 text-text rounded-lg transition-colors"
            >
              下一章 →
            </button>
          </div>
          <div class="flex items-center space-x-2">
            <button class="p-2 hover:bg-surface/50 rounded" title="调整字号">
              <i class="ri-font-size text-lg text-text-tertiary"></i>
            </button>
            <button class="p-2 hover:bg-surface/50 rounded" title="夜间模式">
              <i class="ri-moon-line text-lg text-text-tertiary"></i>
            </button>
            <button class="p-2 hover:bg-surface/50 rounded" title="加入书签">
              <i class="ri-bookmark-line text-lg text-text-tertiary"></i>
            </button>
          </div>
        </div>
      </article>
    </div>

    <!-- 侧边栏：智能标注 -->
    <aside class="lg:col-span-1">
      <div class="bg-surface rounded-xl shadow-lg p-6 border border-border sticky top-24">
        <h3 class="text-lg font-bold text-text mb-4 flex items-center">
          <i class="ri-book-mark-line text-lg text-accent mr-2"></i>
          智能标注
        </h3>
        <div class="space-y-3">
          {
            data.annotations.map((anno) => (
              <div class="p-3 bg-surface/50 rounded-lg border border-border">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-text">{anno.term}</span>
                  <span
                    class={`text-xs px-2 py-0.5 rounded ${
                      anno.type === 'philosophy'
                        ? 'bg-blue-100 text-blue-600'
                        : anno.type === 'person'
                          ? 'bg-green-100 text-green-600'
                          : 'bg-purple-100 text-purple-600'
                    }`}
                  >
                    {anno.type === 'philosophy' ? '哲学' : anno.type === 'person' ? '人物' : '概念'}
                  </span>
                </div>
                <p class="text-sm text-text-secondary">{anno.note}</p>
              </div>
            ))
          }
        </div>

        <!-- AI 助手入口 -->
        <div class="mt-6 pt-6 border-t border-border">
          <button
            class="w-full py-3 bg-gradient-to-r from-zhusha-500 to-zhusha-600 text-white rounded-lg hover:from-zhusha-600 hover:to-zhusha-700 transition-all flex items-center justify-center"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
              ></path>
            </svg>
            向 AI 提问
          </button>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
