---
import BaseLayout from '../layouts/BaseLayout.astro';

// 404 页面 - 处理所有未匹配的路由
// 古典风格错误提示
---

<BaseLayout title="页面未找到">
  <div class="min-h-[70vh] flex items-center justify-center py-12">
    <div class="text-center max-w-2xl mx-auto px-8">
      <!-- 古典图标：明月/书卷 -->
      <div class="relative mb-8">
        <div
          class="w-32 h-32 bg-gradient-to-b from-xuanzhi-100 to-xuanzhi-200 rounded-full flex items-center justify-center mx-auto shadow-lg border-2 border-juanbo-300"
        >
          <svg class="w-16 h-16 text-mo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
        </div>
        <!-- 装饰云纹 -->
        <div class="absolute -top-2 -right-2 w-8 h-8 text-zhusha-400 opacity-60">
          <svg fill="currentColor" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="40" stroke="currentColor" stroke-width="3" fill="none"
            ></circle>
          </svg>
        </div>
      </div>

      <!-- 错误代码 - 使用隶书 -->
      <h1 class="text-8xl font-bold text-mo-600 mb-2 font-li tracking-wider">四〇四</h1>

      <!-- 古典诗词风格提示 -->
      <div class="mb-8">
        <p class="text-2xl text-mo-500 font-song mb-4">蓦然回首，卿在何处？</p>
        <p class="text-mo-400 text-sm leading-relaxed">
          此页已随黄鹤去，空余明月照书楼。<br />
          君所寻之典籍，或已迁移，或未收录。<br />
          不妨归去来兮，再觅他山之玉。
        </p>
      </div>

      <!-- 操作按钮 - 仿古风格 -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a
          href="/"
          class="group px-8 py-3 bg-gradient-to-r from-zhusha-500 to-zhusha-600 hover:from-zhusha-600 hover:to-zhusha-700 text-white rounded-lg transition-all shadow-md hover:shadow-lg font-song"
        >
          <span class="flex items-center justify-center">
            <svg
              class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path>
            </svg>
            归去来兮 · 返回首页
          </span>
        </a>
        <a
          href="/guji/zhong-yong"
          class="group px-8 py-3 bg-xuanzhi-100 hover:bg-xuanzhi-200 text-mo-600 rounded-lg transition-all border border-juanbo-300 font-song"
        >
          <span class="flex items-center justify-center">
            <svg
              class="w-5 h-5 mr-2 group-hover:rotate-12 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
            browse 古籍 · browse 典籍
          </span>
        </a>
      </div>

      <!-- 四部快速访问 - 仿古卡片 -->
      <div class="mt-8 pt-8 border-t-2 border-juanbo-200">
        <h3 class="text-lg font-bold text-mo-500 mb-6 font-li">四库全书 · 快速访问</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a
            href="/经部"
            class="group p-4 bg-white rounded-lg border border-juanbo-200 hover:border-zhusha-300 hover:shadow-md transition-all"
          >
            <div class="text-2xl mb-2">📜</div>
            <div
              class="text-sm font-bold text-mo-600 group-hover:text-zhusha-500 transition-colors"
            >
              经部
            </div>
            <div class="text-xs text-mo-400">十三经注疏</div>
          </a>
          <a
            href="/史部"
            class="group p-4 bg-white rounded-lg border border-juanbo-200 hover:border-zhusha-300 hover:shadow-md transition-all"
          >
            <div class="text-2xl mb-2">📚</div>
            <div
              class="text-sm font-bold text-mo-600 group-hover:text-zhusha-500 transition-colors"
            >
              史部
            </div>
            <div class="text-xs text-mo-400">二十四史书</div>
          </a>
          <a
            href="/子部"
            class="group p-4 bg-white rounded-lg border border-juanbo-200 hover:border-zhusha-300 hover:shadow-md transition-all"
          >
            <div class="text-2xl mb-2">🎋</div>
            <div
              class="text-sm font-bold text-mo-600 group-hover:text-zhusha-500 transition-colors"
            >
              子部
            </div>
            <div class="text-xs text-mo-400">诸子百家言</div>
          </a>
          <a
            href="/集部"
            class="group p-4 bg-white rounded-lg border border-juanbo-200 hover:border-zhusha-300 hover:shadow-md transition-all"
          >
            <div class="text-2xl mb-2">🖋️</div>
            <div
              class="text-sm font-bold text-mo-600 group-hover:text-zhusha-500 transition-colors"
            >
              集部
            </div>
            <div class="text-xs text-mo-400">诗词曲赋集</div>
          </a>
        </div>
      </div>

      <!-- 底部装饰 -->
      <div class="mt-12 text-mo-300 text-xs font-song">
        <p>📖 竹帛 Ink · 古籍图书馆</p>
      </div>
    </div>
  </div>
</BaseLayout>
