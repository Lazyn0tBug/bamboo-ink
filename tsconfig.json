{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "public"]
}
